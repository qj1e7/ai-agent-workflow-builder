# Superuser password for the postgres container.
POSTGRES_PASSWORD=
# Password of the n8n database role.
N8N_DB_PASSWORD=
# Passwords of the platform database roles.
WAB_OWNER_PASSWORD=
WAB_BUILDER_PASSWORD=
WAB_ORCHESTRATION_PASSWORD=
WAB_MONITORING_PASSWORD=

# Encrypts n8n credentials. Never change it while the n8n volume is kept.
N8N_ENCRYPTION_KEY=
# n8n owner account that bootstrap creates (password needs 8+ characters, a number and a capital).
N8N_OWNER_EMAIL=owner@example.com
N8N_OWNER_PASSWORD=
# Shared by n8n steps and platform-api.
STEP_KEY=
# platform-api sends it to the agent as X-Agent-Key.
AGENT_API_KEY=
# Signs the agent callback tokens.
CALLBACK_SIGNING_KEY=

# The first deploy's people, used only with real sign-in (AUTH_MODE=oidc) and only while the
# People list is empty. One Operator email, and two different Approver emails separated by a comma.
# Dev mode seeds alice, bob and carol instead and ignores these.
FIRST_OPERATOR=
FIRST_APPROVERS=

# Optional. Raises the GitHub rate limit for the agent.
GITHUB_TOKEN=
GITHUB_API_BASE=https://api.github.com

# Host ports. Change one when the port is taken on your machine.
PORTAL_HOST_PORT=8080
PLATFORM_API_HOST_PORT=8000
N8N_HOST_PORT=5678

# Public address of the Portal, used in the Teams card link. Leave it out and it follows PORTAL_HOST_PORT.
# PUBLIC_BASE_URL=http://localhost:8080
