{
  "$defs": {
    "Addressee": {
      "discriminator": {
        "mapping": {
          "agent": "#/$defs/AgentAddressee",
          "room": "#/$defs/RoomAddressee"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/AgentAddressee"
        },
        {
          "$ref": "#/$defs/RoomAddressee"
        }
      ]
    },
    "AgentAddressee": {
      "additionalProperties": false,
      "properties": {
        "display": {
          "title": "Display",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "agent",
          "default": "agent",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "id",
        "display"
      ],
      "title": "AgentAddressee",
      "type": "object"
    },
    "AgentCard": {
      "additionalProperties": false,
      "properties": {
        "capabilities": {
          "items": {
            "type": "string"
          },
          "title": "Capabilities",
          "type": "array"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "display": {
          "title": "Display",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "display",
        "description",
        "capabilities"
      ],
      "title": "AgentCard",
      "type": "object"
    },
    "AgentCards": {
      "additionalProperties": false,
      "properties": {
        "agents": {
          "items": {
            "$ref": "#/$defs/AgentCard"
          },
          "title": "Agents",
          "type": "array"
        }
      },
      "required": [
        "agents"
      ],
      "title": "AgentCards",
      "type": "object"
    },
    "AgentEvent": {
      "discriminator": {
        "mapping": {
          "agent_failed": "#/$defs/AgentFailedEvent",
          "agent_joined": "#/$defs/AgentJoinedEvent",
          "agent_message": "#/$defs/AgentMessageEvent",
          "agent_step_finished": "#/$defs/AgentStepFinishedEvent",
          "agent_step_started": "#/$defs/AgentStepStartedEvent"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/AgentJoinedEvent"
        },
        {
          "$ref": "#/$defs/AgentStepStartedEvent"
        },
        {
          "$ref": "#/$defs/AgentStepFinishedEvent"
        },
        {
          "$ref": "#/$defs/AgentFailedEvent"
        },
        {
          "$ref": "#/$defs/AgentMessageEvent"
        }
      ]
    },
    "AgentEventPost": {
      "additionalProperties": false,
      "properties": {
        "event": {
          "$ref": "#/$defs/AgentEvent"
        },
        "task_id": {
          "title": "Task Id",
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "event"
      ],
      "title": "AgentEventPost",
      "type": "object"
    },
    "AgentFailedData": {
      "additionalProperties": false,
      "properties": {
        "error_type": {
          "title": "Error Type",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        },
        "step": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Step"
        }
      },
      "required": [
        "step",
        "error_type",
        "message",
        "retryable"
      ],
      "title": "AgentFailedData",
      "type": "object"
    },
    "AgentFailedEvent": {
      "additionalProperties": false,
      "properties": {
        "agent": {
          "$ref": "#/$defs/AgentRef"
        },
        "agent_seq": {
          "minimum": 1,
          "title": "Agent Seq",
          "type": "integer"
        },
        "data": {
          "$ref": "#/$defs/AgentFailedData"
        },
        "kind": {
          "const": "agent_failed",
          "default": "agent_failed",
          "title": "Kind",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "ts": {
          "format": "date-time",
          "title": "Ts",
          "type": "string"
        }
      },
      "required": [
        "agent_seq",
        "ts",
        "agent",
        "summary",
        "data"
      ],
      "title": "AgentFailedEvent",
      "type": "object"
    },
    "AgentJoinedData": {
      "additionalProperties": false,
      "properties": {
        "agent": {
          "$ref": "#/$defs/AgentRef"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "agent",
        "reason"
      ],
      "title": "AgentJoinedData",
      "type": "object"
    },
    "AgentJoinedEvent": {
      "additionalProperties": false,
      "properties": {
        "agent": {
          "$ref": "#/$defs/AgentRef"
        },
        "agent_seq": {
          "minimum": 1,
          "title": "Agent Seq",
          "type": "integer"
        },
        "data": {
          "$ref": "#/$defs/AgentJoinedData"
        },
        "kind": {
          "const": "agent_joined",
          "default": "agent_joined",
          "title": "Kind",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "ts": {
          "format": "date-time",
          "title": "Ts",
          "type": "string"
        }
      },
      "required": [
        "agent_seq",
        "ts",
        "agent",
        "summary",
        "data"
      ],
      "title": "AgentJoinedEvent",
      "type": "object"
    },
    "AgentMessageData": {
      "additionalProperties": false,
      "properties": {
        "addressee": {
          "$ref": "#/$defs/Addressee"
        },
        "speaker": {
          "$ref": "#/$defs/AgentRef"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "speaker",
        "addressee",
        "text"
      ],
      "title": "AgentMessageData",
      "type": "object"
    },
    "AgentMessageEvent": {
      "additionalProperties": false,
      "properties": {
        "agent": {
          "$ref": "#/$defs/AgentRef"
        },
        "agent_seq": {
          "minimum": 1,
          "title": "Agent Seq",
          "type": "integer"
        },
        "data": {
          "$ref": "#/$defs/AgentMessageData"
        },
        "kind": {
          "const": "agent_message",
          "default": "agent_message",
          "title": "Kind",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "ts": {
          "format": "date-time",
          "title": "Ts",
          "type": "string"
        }
      },
      "required": [
        "agent_seq",
        "ts",
        "agent",
        "summary",
        "data"
      ],
      "title": "AgentMessageEvent",
      "type": "object"
    },
    "AgentRef": {
      "additionalProperties": false,
      "properties": {
        "display": {
          "title": "Display",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "display"
      ],
      "title": "AgentRef",
      "type": "object"
    },
    "AgentStepFinishedData": {
      "additionalProperties": false,
      "properties": {
        "result": {
          "additionalProperties": true,
          "title": "Result",
          "type": "object"
        },
        "step": {
          "title": "Step",
          "type": "string"
        }
      },
      "required": [
        "step",
        "result"
      ],
      "title": "AgentStepFinishedData",
      "type": "object"
    },
    "AgentStepFinishedEvent": {
      "additionalProperties": false,
      "properties": {
        "agent": {
          "$ref": "#/$defs/AgentRef"
        },
        "agent_seq": {
          "minimum": 1,
          "title": "Agent Seq",
          "type": "integer"
        },
        "data": {
          "$ref": "#/$defs/AgentStepFinishedData"
        },
        "kind": {
          "const": "agent_step_finished",
          "default": "agent_step_finished",
          "title": "Kind",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "ts": {
          "format": "date-time",
          "title": "Ts",
          "type": "string"
        }
      },
      "required": [
        "agent_seq",
        "ts",
        "agent",
        "summary",
        "data"
      ],
      "title": "AgentStepFinishedEvent",
      "type": "object"
    },
    "AgentStepStartedData": {
      "additionalProperties": false,
      "properties": {
        "step": {
          "title": "Step",
          "type": "string"
        }
      },
      "required": [
        "step"
      ],
      "title": "AgentStepStartedData",
      "type": "object"
    },
    "AgentStepStartedEvent": {
      "additionalProperties": false,
      "properties": {
        "agent": {
          "$ref": "#/$defs/AgentRef"
        },
        "agent_seq": {
          "minimum": 1,
          "title": "Agent Seq",
          "type": "integer"
        },
        "data": {
          "$ref": "#/$defs/AgentStepStartedData"
        },
        "kind": {
          "const": "agent_step_started",
          "default": "agent_step_started",
          "title": "Kind",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "ts": {
          "format": "date-time",
          "title": "Ts",
          "type": "string"
        }
      },
      "required": [
        "agent_seq",
        "ts",
        "agent",
        "summary",
        "data"
      ],
      "title": "AgentStepStartedEvent",
      "type": "object"
    },
    "BelongsOnWatchlist": {
      "additionalProperties": false,
      "properties": {
        "software": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The software the task names, as the task wrote it.",
          "title": "Software"
        },
        "status": {
          "const": "watchlist",
          "default": "watchlist",
          "title": "Status",
          "type": "string"
        },
        "word": {
          "description": "The word that made the Planner think so, as the task wrote it.",
          "maxLength": 80,
          "minLength": 1,
          "title": "Word",
          "type": "string"
        }
      },
      "required": [
        "word"
      ],
      "title": "BelongsOnWatchlist",
      "type": "object"
    },
    "Callback": {
      "additionalProperties": false,
      "properties": {
        "token": {
          "description": "Sent back as the X-Callback-Token header, never in the URL. The handler must compare it in constant time, bind it to this run_id and task_id, and give it an expiry.",
          "title": "Token",
          "type": "string"
        },
        "url": {
          "description": "Where the agent posts each event. It names only the run and the task.",
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "url",
        "token"
      ],
      "title": "Callback",
      "type": "object"
    },
    "CardBlock": {
      "additionalProperties": false,
      "properties": {
        "say": {
          "description": "The step in plain English.",
          "maxLength": 300,
          "minLength": 1,
          "title": "Say",
          "type": "string"
        },
        "tool": {
          "anyOf": [
            {
              "$ref": "#/$defs/ToolId"
            },
            {
              "type": "null"
            }
          ],
          "description": "The one tool this block uses, or None for a block that only thinks."
        }
      },
      "required": [
        "say",
        "tool"
      ],
      "title": "CardBlock",
      "type": "object"
    },
    "CardDraft": {
      "additionalProperties": false,
      "description": "What the model drafted, unchecked. Tool ids and input kinds are plain text here, because\nthe platform checks the draft and shows an Operator every problem before it can be saved.",
      "properties": {
        "approvals": {
          "items": {
            "$ref": "#/$defs/DraftApproval"
          },
          "title": "Approvals",
          "type": "array"
        },
        "blocks": {
          "items": {
            "$ref": "#/$defs/DraftBlock"
          },
          "title": "Blocks",
          "type": "array"
        },
        "can_do": {
          "title": "Can Do",
          "type": "boolean"
        },
        "good_for": {
          "items": {
            "type": "string"
          },
          "title": "Good For",
          "type": "array"
        },
        "inputs": {
          "items": {
            "$ref": "#/$defs/DraftInput"
          },
          "title": "Inputs",
          "type": "array"
        },
        "missing_tools": {
          "items": {
            "$ref": "#/$defs/MissingTool"
          },
          "title": "Missing Tools",
          "type": "array"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "purpose": {
          "title": "Purpose",
          "type": "string"
        },
        "questions": {
          "items": {
            "type": "string"
          },
          "title": "Questions",
          "type": "array"
        },
        "why_not": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Why Not"
        }
      },
      "required": [
        "can_do",
        "name",
        "purpose"
      ],
      "title": "CardDraft",
      "type": "object"
    },
    "CardInput": {
      "additionalProperties": false,
      "properties": {
        "example": {
          "default": "",
          "maxLength": 100,
          "title": "Example",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/InputKind",
          "description": "What the value is. A write tool's target comes from the card's one input of the kind that tool needs, such as jira_project for jira.create_ticket."
        },
        "name": {
          "maxLength": 60,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "what": {
          "default": "",
          "maxLength": 200,
          "title": "What",
          "type": "string"
        }
      },
      "required": [
        "name",
        "kind"
      ],
      "title": "CardInput",
      "type": "object"
    },
    "CardSpec": {
      "additionalProperties": false,
      "properties": {
        "blocks": {
          "items": {
            "$ref": "#/$defs/CardBlock"
          },
          "maxItems": 12,
          "minItems": 1,
          "title": "Blocks",
          "type": "array"
        },
        "id": {
          "pattern": "^crd_[0-9A-Za-z_]{1,40}$",
          "title": "Id",
          "type": "string"
        },
        "inputs": {
          "items": {
            "$ref": "#/$defs/CardInput"
          },
          "maxItems": 8,
          "title": "Inputs",
          "type": "array"
        },
        "name": {
          "maxLength": 60,
          "minLength": 2,
          "title": "Name",
          "type": "string"
        },
        "purpose": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Purpose",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "version",
        "name",
        "purpose",
        "inputs",
        "blocks"
      ],
      "title": "CardSpec",
      "type": "object"
    },
    "CardToRun": {
      "additionalProperties": false,
      "properties": {
        "card": {
          "$ref": "#/$defs/CardSpec"
        },
        "values": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "One value for each of the card's inputs, by name.",
          "title": "Values",
          "type": "object"
        }
      },
      "required": [
        "card",
        "values"
      ],
      "title": "CardToRun",
      "type": "object"
    },
    "CardsInputs": {
      "additionalProperties": false,
      "properties": {
        "agents": {
          "description": "The agents the Planner brings in, in the order they work.",
          "items": {
            "$ref": "#/$defs/CheckedCardToRun"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Agents",
          "type": "array"
        },
        "kind": {
          "const": "cards",
          "default": "cards",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "agents"
      ],
      "title": "CardsInputs",
      "type": "object"
    },
    "CarryForward": {
      "additionalProperties": false,
      "description": "What a run hands to the next run of its use case.",
      "properties": {},
      "title": "CarryForward",
      "type": "object"
    },
    "CheckedCardToRun": {
      "$ref": "#/$defs/CardToRun"
    },
    "Choice": {
      "additionalProperties": false,
      "properties": {
        "agents": {
          "items": {
            "$ref": "#/$defs/ChosenAgent"
          },
          "maxItems": 3,
          "title": "Agents",
          "type": "array"
        },
        "decision": {
          "$ref": "#/$defs/ChoiceDecision"
        },
        "new_agent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "New Agent"
        },
        "questions": {
          "items": {
            "type": "string"
          },
          "title": "Questions",
          "type": "array"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "decision",
        "reason"
      ],
      "title": "Choice",
      "type": "object"
    },
    "ChoiceDecision": {
      "enum": [
        "use_one",
        "use_several",
        "new_agent",
        "cannot_do"
      ],
      "type": "string"
    },
    "ChooseRequest": {
      "additionalProperties": false,
      "properties": {
        "library": {
          "items": {
            "$ref": "#/$defs/LibraryCard"
          },
          "maxItems": 50,
          "title": "Library",
          "type": "array"
        },
        "model": {
          "$ref": "#/$defs/ModelAccess"
        },
        "task": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Task",
          "type": "string"
        }
      },
      "required": [
        "task",
        "library",
        "model"
      ],
      "title": "ChooseRequest",
      "type": "object"
    },
    "ChooseResult": {
      "discriminator": {
        "mapping": {
          "chosen": "#/$defs/Chosen",
          "problem": "#/$defs/ModelProblem"
        },
        "propertyName": "status"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/Chosen"
        },
        {
          "$ref": "#/$defs/ModelProblem"
        }
      ]
    },
    "Chosen": {
      "additionalProperties": false,
      "properties": {
        "choice": {
          "$ref": "#/$defs/Choice"
        },
        "status": {
          "const": "chosen",
          "default": "chosen",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "choice"
      ],
      "title": "Chosen",
      "type": "object"
    },
    "ChosenAgent": {
      "additionalProperties": false,
      "properties": {
        "card_id": {
          "title": "Card Id",
          "type": "string"
        },
        "part": {
          "title": "Part",
          "type": "string"
        },
        "values": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Only values the task itself says, by input name. Never invented.",
          "title": "Values",
          "type": "object"
        }
      },
      "required": [
        "card_id",
        "part"
      ],
      "title": "ChosenAgent",
      "type": "object"
    },
    "ConnectRequest": {
      "additionalProperties": false,
      "properties": {
        "api_key": {
          "title": "Api Key",
          "type": "string"
        },
        "base_url": {
          "title": "Base Url",
          "type": "string"
        }
      },
      "required": [
        "base_url",
        "api_key"
      ],
      "title": "ConnectRequest",
      "type": "object"
    },
    "ConnectResult": {
      "discriminator": {
        "mapping": {
          "connected": "#/$defs/Connected",
          "problem": "#/$defs/ModelProblem"
        },
        "propertyName": "status"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/Connected"
        },
        {
          "$ref": "#/$defs/ModelProblem"
        }
      ]
    },
    "Connected": {
      "additionalProperties": false,
      "properties": {
        "base_url": {
          "description": "The address to send with this style in a ModelAccess.",
          "title": "Base Url",
          "type": "string"
        },
        "models": {
          "items": {
            "$ref": "#/$defs/FoundModel"
          },
          "title": "Models",
          "type": "array"
        },
        "status": {
          "const": "connected",
          "default": "connected",
          "title": "Status",
          "type": "string"
        },
        "style": {
          "$ref": "#/$defs/ModelStyle"
        }
      },
      "required": [
        "style",
        "base_url",
        "models"
      ],
      "title": "Connected",
      "type": "object"
    },
    "DraftApproval": {
      "additionalProperties": false,
      "properties": {
        "approvers": {
          "title": "Approvers",
          "type": "integer"
        },
        "tool": {
          "title": "Tool",
          "type": "string"
        },
        "why": {
          "default": "",
          "title": "Why",
          "type": "string"
        }
      },
      "required": [
        "tool",
        "approvers"
      ],
      "title": "DraftApproval",
      "type": "object"
    },
    "DraftBlock": {
      "additionalProperties": false,
      "properties": {
        "say": {
          "title": "Say",
          "type": "string"
        },
        "tool": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Tool"
        }
      },
      "required": [
        "say",
        "tool"
      ],
      "title": "DraftBlock",
      "type": "object"
    },
    "DraftInput": {
      "additionalProperties": false,
      "properties": {
        "example": {
          "default": "",
          "title": "Example",
          "type": "string"
        },
        "kind": {
