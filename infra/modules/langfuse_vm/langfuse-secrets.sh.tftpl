#!/bin/sh
# Reads Langfuse's secrets from Key Vault with the VM's managed identity (ADR 0050) into an env file
# only root can read. langfuse.service runs it before every start, so a secret a person changes in
# Key Vault applies at the next restart.
set -eu
umask 077

json_field() {
  python3 -c 'import json, sys; print(json.load(sys.stdin)[sys.argv[1]])' "$1"
}

token=$(curl -fsS --retry 10 --retry-delay 6 --retry-all-errors -H Metadata:true \
  "http://169.254.169.254/metadata/identity/oauth2/token?api-version=2018-02-01&resource=https%3A%2F%2Fvault.azure.net&client_id=${client_id}" |
  json_field access_token)

tmp=$(mktemp /etc/langfuse/secrets.env.XXXXXX)
trap 'rm -f "$tmp"' EXIT
while read -r name url; do
  value=$(curl -fsS --retry 5 --retry-delay 10 --retry-all-errors -H "Authorization: Bearer $token" \
    "$url?api-version=7.4" | json_field value)
  case $value in
    *\\* | *"
"*)
      echo "langfuse-secrets: $name holds a backslash or a line break, which Compose would change. Set it again without one." >&2
      exit 1
      ;;
  esac
  # Single quotes keep Compose from reading a $ in a value as a variable, and Compose reads \' as '.
  printf "%s='%s'\n" "$name" "$(printf '%s' "$value" | sed "s/'/\\\\'/g")" >>"$tmp"
done <<SECRETS
%{ for name, url in secrets ~}
${name} ${url}
%{ endfor ~}
SECRETS
mv "$tmp" /etc/langfuse/secrets.env
trap - EXIT
