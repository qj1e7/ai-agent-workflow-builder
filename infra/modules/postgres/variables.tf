variable "name" {
  description = "Globally unique server name."
  type        = string
}

variable "location" {
  description = "Azure region."
  type        = string
}

variable "resource_group_name" {
  description = "Resource group that holds the server."
  type        = string
}

variable "administrator_login" {
  description = "Admin role name. The db-init job uses it to create the per-context roles."
  type        = string
}

variable "administrator_password" {
  description = "Admin password, generated by the caller."
  type        = string
  sensitive   = true
}

variable "databases" {
  description = "Databases to create on the server."
  type        = list(string)
}

variable "tags" {
  description = "Tags for every resource."
  type        = map(string)
}
