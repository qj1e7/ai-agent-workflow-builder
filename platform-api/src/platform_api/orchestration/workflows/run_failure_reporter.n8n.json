{
  "name": "run_failure_reporter",
  "nodes": [
    {
      "id": "error-trigger",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [0, 0],
      "parameters": {}
    },
    {
      "id": "report-a-failure",
      "name": "Report a failure",
      "type": "CUSTOM.wabReportFailure",
      "typeVersion": 1,
      "position": [220, 0],
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 3000,
      "parameters": {}
    }
  ],
  "connections": {
    "Error Trigger": { "main": [[{ "node": "Report a failure", "type": "main", "index": 0 }]] }
  },
  "settings": {
    "executionOrder": "v1",
    "callerPolicy": "any"
  }
}
