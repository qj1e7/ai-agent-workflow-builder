    "checks": [true],
    "replies": [
      {"calls": [{"name": "write_scenarios", "args": {"cover": []}}]},
      {"calls": [{"name": "simulate", "args": {"scenarios": []}}]},
      {"calls": [{"name": "write_scenarios", "args": {"cover": ["Tell them it was declined"]}}]},
      {"calls": [{"name": "simulate", "args": {"scenarios": []}}]},
      {"calls": [{"name": "check_version", "args": {}}]},
      {"calls": [{"name": "hand_in", "args": {}}]}
