        ["Ask for a yes", "No", "Tell them it was declined"]
      ]
    },
    "refine": {"not_reached": ["Tell them it was declined"]},
    "baseline_not_reached": ["Tell them it was declined"],
    "reaches": {"reach_declined": ["Tell them it was declined"]},
    "scenarios": [
      [{"name": "happy_path", "reads": ["Read new releases"]}],
      [{"name": "reach_declined", "kind": "approver_says_no", "reads": ["Read new releases"]}]
