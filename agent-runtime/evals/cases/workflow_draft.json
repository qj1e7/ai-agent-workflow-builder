  {
    "id": "release-check",
    "note": "The baseline the Planner already lays out: read a repository's releases, one Jira write through our blocks.",
    "words": "Every Monday at 9am, check langchain-ai/langgraph for new releases and open a Jira ticket in MOCK for each one.",
    "facts": {"jira_projects": ["MOCK"], "repositories": ["langchain-ai/langgraph"]},
    "outcomes": ["drafted"],
    "must_use": ["CUSTOM.wabRead", "CUSTOM.wabProposeChange", "CUSTOM.wabAskForYes", "CUSTOM.wabMakeApprovedChanges"],
    "must_not_use": ["n8n-nodes-base.jira", "n8n-nodes-base.httpRequest"],
    "filled": ["run_time", "repository", "jira_project"],
    "needed": [],
    "flags": [],
    "changes_access": false,
    "can_run": true,
    "cant_run_because": null,
    "planted": null,
    "reference": {
      "name": "LangGraph release check",
      "blocks": [
        {"name": "Every Monday", "type": "n8n-nodes-base.scheduleTrigger", "version": 1.4, "parameters": {"rule": "<<run_time>>"}},
        {"name": "Read new releases", "type": "CUSTOM.wabRead", "version": 1, "parameters": {"source": "github_releases", "place": "<<repository>>"}},
        {"name": "Propose a ticket", "type": "CUSTOM.wabProposeChange", "version": 1, "parameters": {"action": "jira.create_ticket", "place": "<<jira_project>>", "title": "={{ 'New release ' + $json.tag }}", "body": "={{ $json.notes }}", "subject": "={{ $json.tag }}"}},
        {"name": "Ask for a yes", "type": "CUSTOM.wabAskForYes", "version": 1, "parameters": {}},
        {"name": "Make the ticket", "type": "CUSTOM.wabMakeApprovedChanges", "version": 1, "parameters": {}}
      ],
      "wires": [
        {"from_block": "Every Monday", "exit": "main", "to_block": "Read new releases"},
        {"from_block": "Read new releases", "exit": "main", "to_block": "Propose a ticket"},
        {"from_block": "Propose a ticket", "exit": "main", "to_block": "Ask for a yes"},
        {"from_block": "Ask for a yes", "exit": "Yes", "to_block": "Make the ticket"}
      ],
      "settings": [
        {"id": "run_time", "kind": "run_time", "label": "When it runs", "value": null},
        {"id": "repository", "kind": "repository", "label": "The repository", "value": "langchain-ai/langgraph"},
        {"id": "jira_project", "kind": "jira_project", "label": "The Jira project", "value": "MOCK"}
      ]
    }
  },
